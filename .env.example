# ---- copy to .env and fill in. never commit .env ----

# --- LLM (MiMo default, free tier) ---
LLM_PROVIDER=mimo
MIMO_API_KEY=                # tp-... key from token plan
MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# --- footage source (Pexels only) ---
PEXELS_API_KEY=              # 200 req/hr, 20k/mo — free

# --- reddit (text only, read-only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shitpost-factory/0.1

# --- TTS ---
TTS_PROVIDER=edge            # edge | piper
TTS_VOICE=en-US-AndrewNeural

# --- publishing: postiz (primary) ---
POSTIZ_API_URL=http://localhost:5000/api/public/v1
POSTIZ_API_KEY=

# --- publishing: direct api fallbacks ---
YOUTUBE_CLIENT_SECRETS_FILE=./credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./credentials/youtube_token.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- runtime ---
DRY_RUN=true                 # true = render but never publish
LOG_LEVEL=INFO
