# ---- copy to .env and fill in. never commit .env ----

# --- LLM (pick one; see docs/research-2026.md section 7) ---
LLM_PROVIDER=gemini            # gemini | mimo | ollama | groq
GEMINI_API_KEY=
MIMO_API_KEY=                  # from platform.xiaomimimo.com ONLY
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=MiMo-V2.5
OLLAMA_HOST=http://localhost:11434
GROQ_API_KEY=

# --- footage sources ---
PEXELS_API_KEY=                # 200 req/hr, 20k/mo
PIXABAY_API_KEY=

# --- reddit (text only, read-only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shitpost-factory/0.1

# --- TTS ---
TTS_PROVIDER=edge              # edge | piper | mimo
TTS_VOICE=en-US-AndrewNeural

# --- publishing: postiz (primary) ---
POSTIZ_API_URL=http://localhost:5000/api/public/v1
POSTIZ_API_KEY=

# --- publishing: direct api fallbacks (see docs section 3) ---
YOUTUBE_CLIENT_SECRETS_FILE=./credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=./credentials/youtube_token.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- runtime ---
DRY_RUN=true                   # true = render but never publish
LOG_LEVEL=INFO
